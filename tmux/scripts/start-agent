#!/bin/bash
# Create a shell-backed tmux window, start a supported CLI in a role, and verify it.
set -euo pipefail

usage() {
  echo "usage: start-agent --session SESSION --window WINDOW --cwd PATH --cli codex|claude|opencode --persona planner|implementer|reviewer|explorer --model MODEL --effort EFFORT" >&2
}

fail() {
  echo "start-agent: $*" >&2
  exit 2
}

session='' window='' project_dir='' cli='' persona='' model='' effort=''
while [[ $# -gt 0 ]]; do
  case "$1" in
    --session|--window|--cwd|--cli|--persona|--model|--effort)
      [[ $# -ge 2 ]] || { usage; exit 2; }
      key=${1#--}
      value=$2
      case "$key" in
        session) session=$value ;;
        window) window=$value ;;
        cwd) project_dir=$value ;;
        cli) cli=$value ;;
        persona) persona=$value ;;
        model) model=$value ;;
        effort) effort=$value ;;
      esac
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 2
      ;;
  esac
done

[[ -n "$session" && -n "$window" && -n "$project_dir" && -n "$cli" && -n "$persona" && -n "$model" && -n "$effort" ]] || {
  usage
  exit 2
}

case "$cli" in codex|claude|opencode) ;; *) fail "unsupported CLI: $cli" ;; esac
case "$persona" in planner|implementer|reviewer|explorer) ;; *) fail "unsupported persona: $persona" ;; esac
[[ "$model" != *$'\n'* && "$effort" =~ ^[A-Za-z0-9._-]+$ ]] || fail "model and effort must be single-line values"
[[ -d "$project_dir" ]] || fail "working directory does not exist: $project_dir"
command -v tmux >/dev/null 2>&1 || fail "tmux is not installed or not on PATH"
command -v ps >/dev/null 2>&1 || fail "ps is not installed or not on PATH"
command -v "$cli" >/dev/null 2>&1 || fail "$cli is not installed or not on PATH"

if [[ -n "${TMUX_SOCKET_PATH:-}" && -n "${TMUX_SOCKET_NAME:-}" ]]; then
  fail "set only one of TMUX_SOCKET_PATH or TMUX_SOCKET_NAME"
fi
if [[ -n "${TMUX_SOCKET_PATH:-}" ]]; then
  tmux_cmd=(tmux -S "$TMUX_SOCKET_PATH")
elif [[ -n "${TMUX_SOCKET_NAME:-}" ]]; then
  tmux_cmd=(tmux -L "$TMUX_SOCKET_NAME")
else
  tmux_cmd=(tmux)
fi

"${tmux_cmd[@]}" has-session -t "=$session" 2>/dev/null || fail "no such session on the selected socket: $session"
if "${tmux_cmd[@]}" list-windows -t "=$session" -F '#{window_name}' | grep -qFx -- "$window"; then
  fail "window already exists in session $session: $window"
fi

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
skill_dir=$(cd "$script_dir/.." && pwd)
common_source="$skill_dir/personas/source/common.md"
role_source="$skill_dir/personas/source/$persona.md"
claude_bundle="$skill_dir/personas/claude/agents.json"
opencode_bundle="$skill_dir/personas/opencode/opencode.json"
for required in "$common_source" "$role_source"; do
  [[ -f "$required" ]] || fail "missing persona source: $required"
done

shell_quote() {
  printf '%q' "$1"
}

q_model=$(shell_quote "$model")
q_effort=$(shell_quote "$effort")
q_persona=$(shell_quote "$persona")
q_common=$(shell_quote "$common_source")
q_role=$(shell_quote "$role_source")
activation='native-launch'
ready_marker=''

case "$cli" in
  codex)
    activation='codex-adapter'
    effort_config=$(shell_quote "model_reasoning_effort=\"$effort\"")
    command_text="codex -m $q_model -c $effort_config"
    if [[ "$persona" == planner ]]; then
      plan_effort_config=$(shell_quote "plan_mode_reasoning_effort=\"$effort\"")
      command_text+=" -c $plan_effort_config"
    fi
    if [[ "$persona" != implementer ]]; then
      command_text+=' -s read-only'
    fi
    command_text+=" -c \"developer_instructions='''\$(cat -- $q_common $q_role)'''\""
    ready_marker='Ask Codex to do anything'
    ;;
  claude)
    [[ -f "$claude_bundle" ]] || fail "missing Claude agent bundle: $claude_bundle"
    q_bundle=$(shell_quote "$claude_bundle")
    command_text="claude --agents \"\$(cat -- $q_bundle)\" --agent $q_persona --model $q_model --effort $q_effort"
    ready_marker='❯'
    ;;
  opencode)
    [[ -f "$opencode_bundle" ]] || fail "missing OpenCode config: $opencode_bundle"
    [[ -z "${OPENCODE_CONFIG:-}" && -z "${OPENCODE_CONFIG_CONTENT:-}" ]] || fail "OPENCODE_CONFIG and OPENCODE_CONFIG_CONTENT must be unset so bundled persona configuration is not silently merged or replaced"
    q_bundle=$(shell_quote "$opencode_bundle")
    overlay="{\"agent\":{\"$persona\":{\"reasoningEffort\":\"$effort\"}}}"
    q_overlay=$(shell_quote "$overlay")
    command_text="OPENCODE_CONFIG=$q_bundle OPENCODE_CONFIG_CONTENT=$q_overlay opencode --agent $q_persona -m $q_model"
    ready_marker='tab agents'
    ;;
esac

raw_target=$("${tmux_cmd[@]}" new-window -d -P -F '#{session_name}:#{window_index}' -t "=$session:" -n "$window" -c "$project_dir")
target="=$raw_target"

show_target() {
  "${tmux_cmd[@]}" display-message -p -t "$target" '#{session_name}:#{window_index}.#{pane_index} #{pane_current_command}'
}

capture_tail() {
  "${tmux_cmd[@]}" capture-pane -p -t "$target" | tail -30
}

blocked_dialog() {
  local screen
  screen=$("${tmux_cmd[@]}" capture-pane -p -J -t "$target" -S -200 2>/dev/null || true)
  printf '%s\n' "$screen" | grep -Eiq 'do you trust|trust the contents|log[ -]?in required|select (a )?login|permission required|confirm purchase|destructive action'
}

wait_for_marker_or_dialog() {
  local marker=$1 timeout=$2 deadline screen
  deadline=$(( $(date +%s) + timeout ))
  while true; do
    screen=$("${tmux_cmd[@]}" capture-pane -p -J -t "$target" -S -200 2>/dev/null) || return 1
    if printf '%s\n' "$screen" | grep -qF -- "$marker"; then
      return 0
    fi
    if printf '%s\n' "$screen" | grep -Eiq 'do you trust|trust the contents|log[ -]?in required|select (a )?login|permission required|confirm purchase|destructive action'; then
      return 3
    fi
    (( $(date +%s) >= deadline )) && return 1
    sleep 0.5
  done
}

wait_for_visible_marker_or_dialog() {
  local marker=$1 timeout=$2 deadline screen
  deadline=$(( $(date +%s) + timeout ))
  while true; do
    screen=$("${tmux_cmd[@]}" capture-pane -p -J -t "$target" 2>/dev/null) || return 1
    if printf '%s\n' "$screen" | grep -qiF -- "$marker"; then
      return 0
    fi
    if printf '%s\n' "$screen" | grep -Eiq 'do you trust|trust the contents|log[ -]?in required|select (a )?login|permission required|confirm purchase|destructive action'; then
      return 3
    fi
    (( $(date +%s) >= deadline )) && return 1
    sleep 0.5
  done
}

wait_for_cli_process() {
  local deadline tty command_line first second candidate
  deadline=$(( $(date +%s) + 45 ))
  tty=$("${tmux_cmd[@]}" display-message -p -t "$target" '#{pane_tty}')
  tty=${tty#/dev/}
  while (( $(date +%s) < deadline )); do
    while IFS= read -r command_line; do
      first=${command_line%% *}
      second=${command_line#* }
      second=${second%% *}
      candidate=${first##*/}
      case "$candidate" in
        node|bash|sh|zsh) candidate=${second##*/} ;;
      esac
      [[ "$candidate" == "$cli" || "$candidate" == "$cli.exe" || "$candidate" == "$cli.js" ]] && return 0
    done < <(ps -t "$tty" -o command= 2>/dev/null)
    sleep 0.5
  done
  return 1
}

send_literal() {
  local text=$1
  show_target >/dev/null
  capture_tail >/dev/null
  "${tmux_cmd[@]}" send-keys -t "$target" -l -- "$text"
  sleep 0.4
  "${tmux_cmd[@]}" send-keys -t "$target" Enter
  sleep 0.2
  capture_tail >/dev/null
}

echo "target=$raw_target"
echo "exact_target=$target"
echo "cli=$cli"
echo "persona=$persona"
echo "activation=$activation"

send_literal "$command_text"
if ! wait_for_cli_process; then
  if blocked_dialog; then
    echo "start-agent: a trust, login, permission, purchase, or destructive dialog may be blocking $target; it was not answered" >&2
  else
    echo "start-agent: the expected $cli process was not verified on $target" >&2
  fi
  exit 3
fi
if ! wait_for_visible_marker_or_dialog "$ready_marker" 45; then
  if blocked_dialog; then
    echo "start-agent: a trust, login, permission, purchase, or destructive dialog may be blocking $target; it was not answered" >&2
  else
    echo "start-agent: CLI did not reach its readiness marker; inspect $target" >&2
  fi
  exit 3
fi
if blocked_dialog; then
  echo "start-agent: a trust, login, permission, purchase, or destructive dialog may be blocking $target; it was not answered" >&2
  exit 3
fi
if [[ "$cli" == opencode ]] && ! wait_for_visible_marker_or_dialog "$persona" 5; then
  echo "start-agent: OpenCode started but the requested persona was not visible; inspect $target" >&2
  exit 3
fi
# A visible marker can appear before a full-screen TUI has focused its input.
# Let two render cycles settle before sending the activation check.
sleep 2

if [[ "$cli" == codex && "$persona" == planner ]]; then
  show_target >/dev/null
  capture_tail >/dev/null
  "${tmux_cmd[@]}" send-keys -t "$target" BTab
  sleep 0.4
  capture_tail >/dev/null
  if ! wait_for_marker_or_dialog 'Plan mode' 15; then
    echo "start-agent: Codex did not visibly enter Plan mode; inspect $target" >&2
    exit 3
  fi
  if blocked_dialog; then
    echo "start-agent: a blocking dialog appeared after the Codex mode transition; it was not answered" >&2
    exit 3
  fi
fi

send_literal 'Report your tmux persona activation marker and nothing else.'
expected="TMUX_PERSONA_ACTIVE=$persona"
if ! wait_for_marker_or_dialog "$expected" 45; then
  echo "start-agent: persona marker was not verified; inspect $target" >&2
  exit 3
fi

echo "marker=$expected"
echo "status=verified"
